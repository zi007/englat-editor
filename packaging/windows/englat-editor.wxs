<?xml version="1.0" encoding="utf-8"?>
<!--
  ENGLAT Editor MSI (WiX Toolset v5: `dotnet tool install -g wix`, plus its UI and Util extensions:
  `wix extension add -g WixToolset.UI.wixext/5.0.2` and the same for WixToolset.Util.wixext).
  Built by package.ps1:

    wix build englat-editor.wxs -arch x64 -ext WixToolset.UI.wixext -ext WixToolset.Util.wixext
      -d Version=1.2.3 -d BinDir=... -d IconPath=... -d LicenseRtf=... -o out.msi

  Per-machine install into Program Files with a Start Menu shortcut. The installer shows the
  standard WiX dialogs: welcome + license, progress, and a finish page.

  UpgradeCode and the component GUIDs below belong to ENGLAT Editor alone. Never copy them from (or
  into) a sibling Craft app: Windows Installer treats every package sharing an UpgradeCode as one
  product, so a shared code makes one app's installer refuse to install ("a newer version is
  already installed") or silently uninstall the other. packaging-lint.yml checks this.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package
      Name="ENGLAT Editor"
      Manufacturer="Learning Machines LLC"
      Version="$(var.Version)"
      UpgradeCode="075497F9-E861-45D0-9C7F-A74F8C34E6BA"
      Scope="perMachine"
      Compressed="yes"
      Language="1033">
    <SummaryInformation Description="ENGLAT Editor word processor" Manufacturer="Learning Machines LLC" />
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of ENGLAT Editor is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="EnglatEditorIcon.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="EnglatEditorIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/zi007/englat-editor" />
    <Property Id="ARPURLUPDATEINFO" Value="https://github.com/zi007/englat-editor" />
    <Property Id="ARPHELPLINK" Value="https://englat.com" />

    <!-- Installer UI (#198): WixUI_Minimal is welcome + license, progress, then a finish page so
         people can see the install worked. Its dialogs and bitmaps are WiX's own
         (WixToolset.UI.wixext); package.ps1 builds the license RTF from LICENSE-MIT and
         LICENSE-APACHE. The finish page offers to launch ENGLAT Editor (ticked by default) through
         WixShellExec (WixToolset.Util.wixext); silent installs (/qn) never show it. -->
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtf)" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch ENGLAT Editor" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WixShellExecTarget" Value="[#EnglatEditorExe]" />
    <CustomAction Id="LaunchENGLAT Editor" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixShellExec"
        Impersonate="yes" Return="ignore" />
    <UI>
      <ui:WixUI Id="WixUI_Minimal" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchENGLAT Editor"
          Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
    </UI>

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="ENGLAT Editor" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <Feature Id="Main" Title="ENGLAT Editor" Level="1">
      <ComponentGroupRef Id="EnglatEditorFiles" />
    </Feature>
  </Package>

  <Fragment>
    <ComponentGroup Id="EnglatEditorFiles" Directory="INSTALLFOLDER">
      <Component Id="EnglatEditorApp" Guid="855DCEC6-9285-444F-9382-9654B83B34F6">
        <File Id="EnglatEditorExe" Source="$(var.BinDir)\englat-editor.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="ENGLAT Editor"
              Description="ENGLAT Editor word processor" WorkingDirectory="INSTALLFOLDER" Advertise="yes"
              Icon="EnglatEditorIcon.ico" IconIndex="0" />
        </File>

        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\englat-editor.exe" Value="[#EnglatEditorExe]" Type="string" />
      </Component>

      <!-- File associations (#295). Each document type gets a ENGLAT Editor ProgId (name, icon, open
           command) and is listed under the extension's OpenWithProgids, so ENGLAT Editor shows in
           Explorer's "Open with". The Word, RTF and ODT types are also ENGLAT Editor's Capabilities
           (RegisteredApplications), so it appears in Settings › Default apps, where the user
           makes it the default (File › Options › General opens that page). Nothing here sets an
           extension's default: the installer never takes over .docx from another app. Markdown and
           plain text are only "Open with" candidates. Removed again on uninstall. -->
      <Component Id="EnglatEditorFileTypes" Guid="EFF89E6A-F9B8-49F9-B3AE-E243347484B4">
        <RegistryValue Root="HKLM" Key="Software\RegisteredApplications" Name="ENGLAT Editor" Value="Software\ENGLAT Editor\Capabilities" Type="string" KeyPath="yes" />
        <RegistryValue Root="HKLM" Key="Software\ENGLAT Editor\Capabilities" Name="ApplicationName" Value="ENGLAT Editor" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\ENGLAT Editor\Capabilities" Name="ApplicationDescription" Value="Write and design documents; open and save Word files." Type="string" />
        <RegistryValue Root="HKLM" Key="Software\ENGLAT Editor\Capabilities" Name="ApplicationIcon" Value="&quot;[#EnglatEditorExe]&quot;,0" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\englat-editor.exe" Name="FriendlyAppName" Value="ENGLAT Editor" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\englat-editor.exe\shell\open\command" Value="&quot;[#EnglatEditorExe]&quot; &quot;%1&quot;" Type="string" />

        <ProgId Id="ENGLAT Editor.Document" Description="Word Document" Icon="EnglatEditorExe" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\ENGLAT Editor.Document\shell\open\command" Value="&quot;[#EnglatEditorExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.docx\OpenWithProgids" Name="ENGLAT Editor.Document" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\englat-editor.exe\SupportedTypes" Name=".docx" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\ENGLAT Editor\Capabilities\FileAssociations" Name=".docx" Value="ENGLAT Editor.Document" Type="string" />

        <ProgId Id="ENGLAT Editor.DocumentMacroEnabled" Description="Word Macro-Enabled Document" Icon="EnglatEditorExe" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\ENGLAT Editor.DocumentMacroEnabled\shell\open\command" Value="&quot;[#EnglatEditorExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.docm\OpenWithProgids" Name="ENGLAT Editor.DocumentMacroEnabled" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\englat-editor.exe\SupportedTypes" Name=".docm" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\ENGLAT Editor\Capabilities\FileAssociations" Name=".docm" Value="ENGLAT Editor.DocumentMacroEnabled" Type="string" />

        <ProgId Id="ENGLAT Editor.Template" Description="Word Template" Icon="EnglatEditorExe" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\ENGLAT Editor.Template\shell\open\command" Value="&quot;[#EnglatEditorExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.dotx\OpenWithProgids" Name="ENGLAT Editor.Template" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\englat-editor.exe\SupportedTypes" Name=".dotx" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\ENGLAT Editor\Capabilities\FileAssociations" Name=".dotx" Value="ENGLAT Editor.Template" Type="string" />

        <ProgId Id="ENGLAT Editor.TemplateMacroEnabled" Description="Word Macro-Enabled Template" Icon="EnglatEditorExe" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\ENGLAT Editor.TemplateMacroEnabled\shell\open\command" Value="&quot;[#EnglatEditorExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.dotm\OpenWithProgids" Name="ENGLAT Editor.TemplateMacroEnabled" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\englat-editor.exe\SupportedTypes" Name=".dotm" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\ENGLAT Editor\Capabilities\FileAssociations" Name=".dotm" Value="ENGLAT Editor.TemplateMacroEnabled" Type="string" />

        <ProgId Id="ENGLAT Editor.LegacyDocument" Description="Legacy Word Document" Icon="EnglatEditorExe" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\ENGLAT Editor.LegacyDocument\shell\open\command" Value="&quot;[#EnglatEditorExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.doc\OpenWithProgids" Name="ENGLAT Editor.LegacyDocument" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\englat-editor.exe\SupportedTypes" Name=".doc" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\ENGLAT Editor\Capabilities\FileAssociations" Name=".doc" Value="ENGLAT Editor.LegacyDocument" Type="string" />

        <ProgId Id="ENGLAT Editor.LegacyTemplate" Description="Legacy Word Template" Icon="EnglatEditorExe" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\ENGLAT Editor.LegacyTemplate\shell\open\command" Value="&quot;[#EnglatEditorExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.dot\OpenWithProgids" Name="ENGLAT Editor.LegacyTemplate" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\englat-editor.exe\SupportedTypes" Name=".dot" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\ENGLAT Editor\Capabilities\FileAssociations" Name=".dot" Value="ENGLAT Editor.LegacyTemplate" Type="string" />

        <ProgId Id="ENGLAT Editor.RichText" Description="Rich Text Document" Icon="EnglatEditorExe" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\ENGLAT Editor.RichText\shell\open\command" Value="&quot;[#EnglatEditorExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.rtf\OpenWithProgids" Name="ENGLAT Editor.RichText" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\englat-editor.exe\SupportedTypes" Name=".rtf" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\ENGLAT Editor\Capabilities\FileAssociations" Name=".rtf" Value="ENGLAT Editor.RichText" Type="string" />

        <ProgId Id="ENGLAT Editor.OpenDocumentText" Description="OpenDocument Text" Icon="EnglatEditorExe" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\ENGLAT Editor.OpenDocumentText\shell\open\command" Value="&quot;[#EnglatEditorExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.odt\OpenWithProgids" Name="ENGLAT Editor.OpenDocumentText" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\englat-editor.exe\SupportedTypes" Name=".odt" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\ENGLAT Editor\Capabilities\FileAssociations" Name=".odt" Value="ENGLAT Editor.OpenDocumentText" Type="string" />

        <ProgId Id="ENGLAT Editor.Markdown" Description="Markdown Document" Icon="EnglatEditorExe" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\ENGLAT Editor.Markdown\shell\open\command" Value="&quot;[#EnglatEditorExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.md\OpenWithProgids" Name="ENGLAT Editor.Markdown" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\englat-editor.exe\SupportedTypes" Name=".md" Value="" Type="string" />

        <ProgId Id="ENGLAT Editor.PlainText" Description="Text Document" Icon="EnglatEditorExe" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\ENGLAT Editor.PlainText\shell\open\command" Value="&quot;[#EnglatEditorExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.txt\OpenWithProgids" Name="ENGLAT Editor.PlainText" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\englat-editor.exe\SupportedTypes" Name=".txt" Value="" Type="string" />
      </Component>

      <Component Id="EnglatEditorCli">
        <File Id="EnglatEditorCliExe" Source="$(var.BinDir)\englat-editor-cli.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
